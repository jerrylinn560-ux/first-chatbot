{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60
    },
    "api/images/generate.ts": {
      "maxDuration": 30
    },
    "api/health.ts": {
      "maxDuration": 10
    },
    "api/models.ts": {
      "maxDuration": 10
    },
    "api/[...path].ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}